# Copy to .env and adjust. .env is git-ignored: never commit real credentials.

# --- Database (used by the PHP app and the ML service) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=FiscalPoint

# --- Web app ---
# Public base URL of the web/ folder; used to build password-reset links.
APP_URL=http://localhost/FiscalPoint/web
APP_DEBUG=false
# Timezone shared by PHP, the MySQL session and the ML service ("this month" must agree everywhere)
APP_TIMEZONE=Asia/Kolkata

# --- Email (password reset + emailed reports). Gmail needs an App Password. ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=

# --- ML service ---
ML_API_URL=http://127.0.0.1:5001
ML_API_HOST=127.0.0.1
ML_API_PORT=5001
# Shared secret sent by PHP in the X-API-Key header. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ML_API_TOKEN=
# Only set to true if the ML service runs on a different machine (requires ML_API_TOKEN).
ML_API_ALLOW_REMOTE=false
# Where the ML service reads data from: mysql (default) or csv (demo without a database).
ML_DATA_SOURCE=mysql
# ML_CSV_PATH=data/synthetic/transactions.csv
# ML_MODEL_DIR=models
ML_LOG_LEVEL=INFO
